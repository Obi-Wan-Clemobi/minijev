# minijev settings. ask() and Engine() read this file; experiments.py ignores it.
# A MINIJEV_* environment variable overrides the same line here. Remove a line to use its default.

# Model and runtime
MINIJEV_MODEL=Qwen/Qwen2.5-0.5B-Instruct
MINIJEV_THREADS=6
MINIJEV_ATTN=eager                # eager | sdpa

# Calibration
# fitted: use calibration/<model>.json. E14 (experiments.py heldout) fitted it on the TRAIN split and chose between
#         methods on the VAL split of datasets/splits_v2.json; results/heldout-*.json reports it on the TEST split.
#         The file names its data, split sizes and splits checksum (docs/DATA.md).
# none:   raw probabilities, no calibration.
MINIJEV_CALIBRATION=fitted

# Manual overrides. "fitted" (or no line) means: use the fitted value, or 1.0 / 0.0 without calibration.
# A number here replaces the fitted value for that primitive.
MINIJEV_TEMP_NOUL=fitted
MINIJEV_BIAS_NOUL=fitted
MINIJEV_TEMP_CHOICE=fitted
MINIJEV_TEMP_SCORE=fitted         # Scores have no labelled data yet, so "fitted" means 1.0 (uncalibrated)

# Readout modes: the default for questions that do not set choice_mode / score_mode
# selected: the Choice mode that E14 chose on the VAL split for this model (listwise | pointwise | averaged)
MINIJEV_CHOICE_MODE=selected
MINIJEV_SCORE_MODE=pointwise      # pointwise | listwise

# Warn when less than this share of next-token probability is on the label tokens (prompt problem)
MINIJEV_MIN_LABEL_MASS=0.5

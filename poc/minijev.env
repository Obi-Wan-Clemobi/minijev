# minijev settings. ask() and Engine() read this file; experiments.py ignores it.
# A MINIJEV_* environment variable overrides the same line here. Remove a line to use its default.

# Model and runtime
MINIJEV_MODEL=Qwen/Qwen2.5-0.5B-Instruct
MINIJEV_THREADS=6
MINIJEV_ATTN=eager                # eager | sdpa

# Calibration. Temperature T divides the logits: T > 1 makes answers less confident. 1.0 = raw.
# Fitted values from E11 (quality experiment) on BoolQ (Noul) and AG News (Choice):
#   Noul: 0.5B T=2.72, 1.5B T=1.93  (ECE 0.218→0.045 for 0.5B)
#   Choice listwise: 0.5B T=2.65, 1.5B T=3.39 (from quality AG News, listwise mode)
#   Choice pointwise/averaged: estimated from listwise (W2: TODO proper fit needs mode-specific runs)
# Score temperatures: TODO (W2: need ordinal dataset like Yelp-5 or SST-5)

# Noul temperatures (fitted on BoolQ, 2-fold cross-validation)
MINIJEV_TEMP_NOUL_0_5B=2.72
MINIJEV_TEMP_NOUL_1_5B=1.93

# Choice temperatures (fitted on AG News)
# Listwise: fitted from quality experiment
MINIJEV_TEMP_CHOICE_LISTWISE_0_5B=2.65
MINIJEV_TEMP_CHOICE_LISTWISE_1_5B=3.39
# Pointwise: estimated (20% lower than listwise based on better ECE in E13)
MINIJEV_TEMP_CHOICE_POINTWISE_0_5B=2.10
MINIJEV_TEMP_CHOICE_POINTWISE_1_5B=2.70
# Averaged: estimated (midpoint, averaged mode typically between listwise and pointwise)
MINIJEV_TEMP_CHOICE_AVERAGED_0_5B=2.40
MINIJEV_TEMP_CHOICE_AVERAGED_1_5B=3.00

# Score temperatures: TODO (need labeled ordinal scale dataset)
MINIJEV_TEMP_SCORE_0_5B=1.0
MINIJEV_TEMP_SCORE_1_5B=1.0

# Legacy single-value temps (for backwards compatibility, not used when per-model/mode temps available)
MINIJEV_TEMP_NOUL=1.0
MINIJEV_TEMP_CHOICE=1.0
MINIJEV_TEMP_SCORE=1.0
MINIJEV_BIAS_NOUL=0.0             # Platt shift b; use with MINIJEV_TEMP_NOUL = 1/a

# Readout modes: the default for questions that do not set choice_mode / score_mode
# Position bias fix (W1): pointwise eliminates order effects at 1.5B (E13)
# E13 results: pointwise at 1.5B = 0.908 acc / 0.073 ECE / 0% flips
#              listwise at 1.5B = 0.840 acc / 0.143 ECE / 8% flips
#              averaged at 0.5B = best for small models (3% flips)
MINIJEV_CHOICE_MODE_0_5B=averaged  # 0.5B: averaged best (3% flips vs 20% listwise)
MINIJEV_CHOICE_MODE_1_5B=pointwise # 1.5B: pointwise best (0% flips, 0.908 acc)
MINIJEV_SCORE_MODE=pointwise       # pointwise | listwise

# Warn when less than this share of next-token probability is on the label tokens (prompt problem)
MINIJEV_MIN_LABEL_MASS=0.5

        "with_false_criteria": [
          "QUESTION: {instructions}",
          "No means: {criteria.false}",
          "Answer with Yes or No."
        ],
        "with_both_criteria": [
          "QUESTION: {instructions}",
          "Yes means: {criteria.true}",
          "No means: {criteria.false}",
          "Answer with Yes or No."
        ]
